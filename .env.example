APP_NAME=AI Pulse
APP_ENV=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://ai_pulse:ai_pulse@postgres:5432/ai_pulse

POSTGRES_DB=ai_pulse
POSTGRES_USER=ai_pulse
POSTGRES_PASSWORD=ai_pulse
POSTGRES_PORT=5432

# Embeddings
EMBEDDING_PROVIDER=local   # local | openai
EMBEDDING_MODEL=all-MiniLM-L6-v2
OPENAI_API_KEY=            # se usar EMBEDDING_PROVIDER=openai

# LLM
LLM_PROVIDER=groq          # groq | openai
LLM_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=              # obrigatório

# RAG
RAG_MAX_AGE_DAYS=3         # janela de recência das notícias usadas no /ask

# Telegram
TELEGRAM_TOKEN=            # token do @BotFather
TELEGRAM_WEBHOOK_URL=      # https://seudominio.com/telegram/webhook