# App
APP_NAME=Vectorpress
APP_ENV=development              # development | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# Database
# Usado pelo backend. No Docker Compose, o host deve ser postgres.
DATABASE_URL=postgresql+asyncpg://vectorpress:vectorpress@postgres:5432/vectorpress
POSTGRES_DB=vectorpress
POSTGRES_USER=vectorpress
POSTGRES_PASSWORD=vectorpress       # altere em producao
POSTGRES_PORT=5432               # porta exposta apenas no compose local
BACKEND_PORT=8000                # porta publica do backend no compose de producao
CORS_ALLOWED_ORIGINS=            # origens separadas por virgula; ex: https://vectorpress.vercel.app

# Embeddings
EMBEDDING_PROVIDER=local         # local | openai
EMBEDDING_MODEL=all-MiniLM-L6-v2 # modelo local padrao, 384 dimensoes
OPENAI_API_KEY=                  # obrigatorio se EMBEDDING_PROVIDER=openai ou LLM_PROVIDER=openai

# LLM
LLM_PROVIDER=groq                # groq | openai
LLM_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=                    # obrigatorio se LLM_PROVIDER=groq

# RAG
RAG_MAX_AGE_DAYS=3               # janela de recencia das noticias usadas no /ask
NEWS_RETENTION_DAYS=7            # janela maxima de retencao de noticias no banco

# Telegram
TELEGRAM_TOKEN=                  # token do @BotFather; vazio deixa o webhook indisponivel
TELEGRAM_WEBHOOK_URL=            # URL publica HTTPS: https://api.seudominio.com/telegram/webhook

# Frontend
VITE_API_PROXY_TARGET=http://backend:8000 # usado apenas pelo Vite dev server
VITE_API_URL=http://localhost:8000        # URL publica da API usada no build estatico

# n8n
N8N_HOST=localhost                       # dominio publico do n8n em producao
N8N_PORT=5678
N8N_PROTOCOL=http                        # http local; https em producao
N8N_WEBHOOK_URL=http://localhost:5678/   # URL publica base dos webhooks do n8n
GENERIC_TIMEZONE=America/Sao_Paulo
