# App
APP_NAME=Vectorpress
# development | production
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Database
# Usado pelo backend. No Docker Compose, o host deve ser postgres.
DATABASE_URL=postgresql+asyncpg://vectorpress:vectorpress@postgres:5432/vectorpress
POSTGRES_DB=vectorpress
POSTGRES_USER=vectorpress
# altere em producao
POSTGRES_PASSWORD=vectorpress
# porta exposta apenas no compose local
POSTGRES_PORT=5432
# porta publica do backend no compose de producao
BACKEND_PORT=8000
# origens separadas por virgula; ex: https://vectorpress.vercel.app
CORS_ALLOWED_ORIGINS=

# Embeddings
# local | openai
EMBEDDING_PROVIDER=local
# modelo local padrao, 384 dimensoes
EMBEDDING_MODEL=all-MiniLM-L6-v2
# obrigatorio se EMBEDDING_PROVIDER=openai ou LLM_PROVIDER=openai
OPENAI_API_KEY=

# LLM
# groq | openai
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
# obrigatorio se LLM_PROVIDER=groq
GROQ_API_KEY=

# RAG
# janela de recencia das noticias usadas no /ask
RAG_MAX_AGE_DAYS=3
# janela maxima de retencao de noticias no banco
NEWS_RETENTION_DAYS=7

# Telegram
# token do @BotFather; vazio deixa o webhook indisponivel
TELEGRAM_TOKEN=
# URL publica HTTPS: https://api.seudominio.com/telegram/webhook
TELEGRAM_WEBHOOK_URL=

# Frontend
# usado apenas pelo Vite dev server
VITE_API_PROXY_TARGET=http://backend:8000
# URL publica da API usada no build estatico
VITE_API_URL=http://localhost:8000

# Cloudflare Tunnel
# token do tunnel criado no painel Zero Trust (apenas producao)
CLOUDFLARE_TUNNEL_TOKEN=

# n8n
# dominio publico do n8n em producao
N8N_HOST=localhost
N8N_PORT=5678
# http local; https em producao
N8N_PROTOCOL=http
# URL publica base dos webhooks do n8n
N8N_WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=America/Sao_Paulo
